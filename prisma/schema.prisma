// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Place {
  id              Int      @id @default(autoincrement())
  osmId           String?  @unique
  name            String
  category        String   // "clinic" or "pet_shop"
  latitude        Float?
  longitude       Float?
  address         String?
  phone           String?
  district        String?
  source          String?
  mapsUrl         String?
  imageUrl        String?
  openingStatus   String?   // e.g. Open, Closed, Open 24 hours
  closingInfo     String?     // e.g. Closes 8 PM, Opens 8 AM Mon
  reviewSnippet   String?
  rating          Float?
  reviewCount     Int?
  lastUpdatedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([district])
  @@index([latitude, longitude])
  @@index([category])
}
