// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Place {
  id              Int      @id @default(autoincrement())
  name            String
  category        String   // clinic, veterinarian, pet_shop
  address         String?
  phone           String?
  latitude        Float?   // optional for now
  longitude       Float?   // optional for now
  rating          Float?
  reviewCount     Int?
  mapsUrl         String?
  imageUrl        String?
  openingStatus   String?   // e.g. Open, Closed, Open 24 hours
  closingInfo     String?     // e.g. Closes 8 PM, Opens 8 AM Mon
  reviewSnippet   String?
  district        String?     // Sri Lanka district
  source          String?          // e.g. csv_google_maps
  lastUpdatedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([latitude])
  @@index([longitude])
}
